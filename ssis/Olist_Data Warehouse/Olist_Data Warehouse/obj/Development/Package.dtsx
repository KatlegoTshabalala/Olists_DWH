  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\02_Create_Schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4054B7B9-A881-4570-A83F-A8BFB3150617}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02_Create_Schema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8207AF0D-142B-4E76-A286-DECFC6CC60EF}"
          SQLTask:SqlStatementSource="&#xA;USE Olists_dwh;&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'bronze')&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;GO&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'silver')&#xA;    EXEC('CREATE SCHEMA silver');&#xA;GO&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'gold')&#xA;    EXEC('CREATE SCHEMA gold');&#xA;GO&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'etl')&#xA;    EXEC('CREATE SCHEMA etl');&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03_Create_Bronze_tables"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{6C581B2A-B049-4E05-A4CC-58197A0D8828}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_Create_Bronze_tables">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\03_Create_Bronze_tables\03_Create_Geolocation_table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E8542836-31D3-4FCF-ACD4-595CB82B3E3E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="03_Create_Geolocation_table"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{8207AF0D-142B-4E76-A286-DECFC6CC60EF}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [Olists_dwh].sys.tables t&#xA;    JOIN [Olists_dwh].sys.schemas s ON s.schema_id = t.schema_id&#xA;    WHERE s.name = N'bronze' AND t.name = N'geolocation'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [Olists_dwh].[bronze].[geolocation] (&#xA;        [geolocation_zip_code_prefix] NVARCHAR(50),&#xA;        [geolocation_lat]             NVARCHAR(50),&#xA;        [geolocation_lng]             NVARCHAR(50),&#xA;        [geolocation_city]            NVARCHAR(100),&#xA;        [geolocation_state]           NVARCHAR(50),&#xA;        [wh_load_ts]                  DATETIME2     DEFAULT SYSDATETIME(),&#xA;        [dwh_source_file]             NVARCHAR(260),&#xA;        [dwh_batch_id]                INT&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Create_Bronze_tables\Customers_table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F098E64C-25AC-4BC3-A45F-072F0930F4C0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Customers_table"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="7">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{8207AF0D-142B-4E76-A286-DECFC6CC60EF}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [Olists_dwh].sys.tables t&#xA;    JOIN [Olists_dwh].sys.schemas s ON s.schema_id = t.schema_id&#xA;    WHERE s.name = N'bronze' AND t.name = N'customers'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [Olists_dwh].[bronze].[customers] (&#xA;        [customer_id]              NVARCHAR(50),&#xA;        [customer_unique_id]       NVARCHAR(50),&#xA;        [customer_zip_code_prefix] NVARCHAR(50),&#xA;        [customer_city]            NVARCHAR(100),&#xA;        [customer_state]           NVARCHAR(50),&#xA;        [wh_load_ts]               DATETIME2     DEFAULT SYSDATETIME(),&#xA;        [dwh_source_file]          NVARCHAR(260),&#xA;        [dwh_batch_id]             INT&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Create_Bronze_tables\Load_Log"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{97371513-7FF6-4875-8D4F-8B85BF49E649}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load_Log"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="8">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{8207AF0D-142B-4E76-A286-DECFC6CC60EF}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM [Olists_dwh].sys.tables t&#xA;               JOIN [Olists_dwh].sys.schemas s ON s.schema_id = t.schema_id&#xA;               WHERE s.name = N'etl' AND t.name = N'load_log')&#xA;BEGIN&#xA;    CREATE TABLE [Olists_dwh].[etl].[load_log] (&#xA;        load_id      INT IDENTITY(1,1) PRIMARY KEY,&#xA;        batch_id     INT           NOT NULL,&#xA;        source_file  NVARCHAR(500) NOT NULL,&#xA;        target_table NVARCHAR(256) NOT NULL,&#xA;        rows_loaded  INT           NULL,&#xA;        load_status  VARCHAR(20)   NOT NULL,&#xA;        load_end     DATETIME2     NOT NULL DEFAULT SYSDATETIME()&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Create_Bronze_tables\Orders_item_table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3825A009-D567-4CDD-800C-DE9BC7CF9239}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
